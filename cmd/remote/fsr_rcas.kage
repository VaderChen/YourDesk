//kage:unit pixels
// AMD FSR 1 RCAS 移植：完整授權見 FSR-LICENSE.txt。
package main
func sample(p vec2) vec3 {
 return imageSrc0UnsafeAt(imageSrc0Origin()+clamp(p,vec2(0.5),imageSrc0Size()-vec2(0.5))).rgb
}
func Fragment(dst vec4, src vec2, color vec4) vec4 {
 p := dst.xy-imageDstOrigin()
 b:=sample(p+vec2(0,-1)); d:=sample(p+vec2(-1,0)); e:=sample(p)
 f:=sample(p+vec2(1,0)); h:=sample(p+vec2(0,1))
 low:=min(min(b,d),min(f,h)); high:=max(max(b,d),max(f,h))
 hitMin:=min(low,e)/max(4*high,vec3(0.00001))
 hitMax:=(vec3(1)-max(high,e))/min(4*low-vec3(4),vec3(-0.00001))
 lobes:=max(-hitMin,hitMax)
 // RCAS 一級衰減，降低桌面文字周圍的銳化光暈。
 lobe:=max(-0.1875,min(max(max(lobes.r,lobes.g),lobes.b),0))*0.5
 return vec4(clamp((lobe*(b+d+f+h)+e)/(4*lobe+1),vec3(0),vec3(1)),1)
}
